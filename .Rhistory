#build the 3-tier ordinal risk outcome
optt_risk <- optt_model_tidy |>
mutate(
#daily price drop (%) from the previous adjusted close; up days count as a 0% drop
price_drop = pmax(-(Adjusted / lag(Adjusted) - 1) * 100, 0),
#baseline volume: average of the PREVIOUS 20 trading days (lagged so today's
#volume does not inflate its own baseline)
volume_baseline = lag(rollmean(Volume, k = 20, fill = NA, align = "right")),
#volume multiple: today's volume relative to the baseline (NA if baseline is 0)
volume_multiple = if_else(volume_baseline > 0, Volume / volume_baseline, NA_real_),
#sell-side volume spike: the multiple only counts on a down day
sell_volume_multiple = if_else(Adjusted < lag(Adjusted), volume_multiple, 0),
#severity tiers:
#Level 3 -> price drop > 7% or volume multiple > 2
#Level 2 -> price drop 3%-7% or volume multiple 1.25-2 (inclusive), nothing past Level 3
#Level 1 -> price drop < 3% and volume multiple < 1.25
risk_level = case_when(
is.na(price_drop) | is.na(sell_volume_multiple) ~ NA_integer_,
price_drop > 7 | sell_volume_multiple > 2 ~ 3L,
price_drop >= 3 | sell_volume_multiple >= 1.25 ~ 2L,
TRUE ~ 1L
),
risk_level = factor(risk_level,
levels = 1:3,
labels = c("No Risk", "Moderate Risk", "High Risk"),
ordered = TRUE),
#predictors are lagged one day (yesterday's indicators predict today's risk),
#otherwise today's rsi/macd/obv already contain today's price drop and volume spike.
#predictors are also standardised since obv, Volume and net_loss are on huge scales
#which stops polr from converging
across(c(rsi, macd_hist, macd_signal, net_loss, obv, Volume, Adjusted),
~ as.numeric(scale(lag(.x))),
.names = "{.col}_lag")
) |>
#shares_outstanding is left out - it is NA before fiscal 2019 (see note above)
drop_na(risk_level, rsi_lag, macd_hist_lag, macd_signal_lag, net_loss_lag,
obv_lag, Volume_lag, Adjusted_lag)
#distribution of the severity tiers
table(optt_risk$risk_level)
#ordinal (proportional odds) logistic regression
#MASS::polr is called directly rather than via library(MASS) since MASS masks dplyr::select
logit <- MASS::polr(risk_level ~ rsi_lag + macd_hist_lag + macd_signal_lag + net_loss_lag +
obv_lag + Volume_lag + Adjusted_lag,
data = optt_risk,
method = "logistic",
Hess = TRUE)
summary(logit)
#polr does not report p-values, so calculate them from the t values
logit_coef <- coef(summary(logit))
logit_p <- 2 * pnorm(abs(logit_coef[, "t value"]), lower.tail = FALSE)
#odds ratios: effect of a 1 standard deviation increase in each (lagged) predictor
#on the odds of being in a higher risk tier
logit_results <- tibble(
term = rownames(logit_coef),
estimate = logit_coef[, "Value"],
std_error = logit_coef[, "Std. Error"],
t_value = logit_coef[, "t value"],
p_value = logit_p
) |>
mutate(odds_ratio = if_else(term %in% names(coef(logit)), exp(estimate), NA_real_))
logit_results
